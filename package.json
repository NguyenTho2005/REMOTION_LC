{
  "name": "REMOTION-LC",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.541",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.541"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.541",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "tts": "PYTHONPATH=tts-service tts-service/.venv/bin/python tts-service/app/main.py",
    "test": "node --experimental-strip-types --test tests/planner.test.ts tests/engines.test.ts tests/pipeline.test.ts",
    "test:tts": "PYTHONPATH=tts-service tts-service/.venv/bin/pytest tts-service/tests",
    "render": "remotion render MyComp out/output.mp4",
    "render:tiktok": "remotion render src/index.ts TikTokVideo out/tiktok-video.mp4",
    "generate": "node --experimental-strip-types scripts/generate-video.ts",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "allowScripts": {
    "esbuild": false
  }
}
